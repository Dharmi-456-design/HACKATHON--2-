{
  "info": {
    "_postman_id": "naturepulse-api-v1-collection",
    "name": "NaturePulse Full-Stack API Collection",
    "description": "Complete Postman v2.1.0 collection for NaturePulse backend endpoints including Auth, Dashboard, Pulse AI, Species Lens, Eco Actions, Nature Missions, Community, Places, and Journal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://naturpulse.onrender.com",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "demo-jwt-token-instant",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
