          "response": [
            {
              "name": "200 Health OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"db\": \"connected\",\n  \"uptime\": 559.5,\n  \"timestamp\": \"2026-08-17T02:27:08.013Z\"\n}"
