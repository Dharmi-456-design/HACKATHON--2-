# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Authentication
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=https://your-auth-proxy-url

# Optional API URL
VITE_API_URL=

# Pulse chat (OpenRouter free models)
# Get a key at https://openrouter.ai/settings/keys
VITE_OPENROUTER_API_KEY=

# Image analysis (Nature Lens + Pulse Chat image uploads) runs in the
# serverless api/ routes. Set GEMINI_API_KEY in the Vercel dashboard
# (or in your local shell when running `vercel dev`) — it must NEVER be
# placed in this file or shipped to the browser.
# GEMINI_API_KEY=

# Green Watch backend (Express + MongoDB + Cloudinary).
# Defaults to http://localhost:5000 when unset.
VITE_GREENWATCH_API_URL=http://localhost:5000
