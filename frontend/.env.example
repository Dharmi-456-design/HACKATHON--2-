# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Authentication
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_PROXY=https://your-auth-proxy-url

# Optional API URL
VITE_API_URL=

# Pulse chat (OpenRouter free models)
# Get a key at https://openrouter.ai/settings/keys
VITE_OPENROUTER_API_KEY=

# Gemini API Key (for Pulse chatbot & Vision)
VITE_GEMINI_API_KEY=

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=

# Green Watch backend (Express + MongoDB + Cloudinary).
# Defaults to http://localhost:5000 when unset.
VITE_GREENWATCH_API_URL=http://localhost:5000
